# Frontend environment variables (Vite). Copy to `.env.local` for local overrides — only `.env.example`
# is committed; all real `.env*` files are gitignored. Vite exposes vars prefixed `VITE_` to the client.

# Backend ORIGIN ONLY for production builds (e.g. Vercel), where there is no Vite dev proxy.
# NO `/v1` and NO trailing slash — the generated API path keys already include `/v1`, and the client
# joins this base with them (see src/api/client.ts). Leave UNSET in development so the Vite dev proxy
# forwards `/v1` to the backend at localhost:3000.
# Example: VITE_API_BASE_URL=https://api.redwave.example
VITE_API_BASE_URL=

# Google Maps browser key for the expense KM entry — enables Places address autocomplete + the route map.
# When UNSET, the KM form falls back to manual address + total-km entry (the server still computes the
# authoritative amount). In Google Cloud enable Maps JavaScript + Places + Directions + Geocoding, turn on
# billing, and restrict the key by HTTP referrer to your domains (e.g. https://app.redwavemarketing.ca/*).
# Baked in at BUILD time — redeploy after changing it. The server has its OWN key (GOOGLE_MAPS_API_KEY)
# that re-derives the authoritative distance. See docs/external-services.md §4b.
VITE_GOOGLE_MAPS_API_KEY=
